    class Shockwave {
      constructor(x, y, maxRadius = 150, color = '#38bdf8') {
        this.x = x;
        this.y = y;
        this.radius = 5;
        this.maxRadius = maxRadius;
        this.color = color;
        this.alpha = 1;
        this.alive = true;
      }

      update() {
        this.radius += (this.maxRadius - this.radius) * 0.15 + 4;
        this.alpha -= 0.035;
        if (this.alpha <= 0 || this.radius >= this.maxRadius) {
          this.alive = false;
        }
      }

      draw(c) {
        c.save();
        c.globalAlpha = Math.max(0, this.alpha);
        c.beginPath();
        c.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
        c.strokeStyle = this.color;
        c.lineWidth = 4 * this.alpha;
        c.shadowColor = this.color;
        c.shadowBlur = 15;
        c.stroke();
        c.restore();
      }
    }

    // --- Parallax Space Background with Warp Dust ---
