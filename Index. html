    // --- Player Vessel ---
    class PlayerShip {
      constructor() {
        this.reset();
      }

      reset() {
        this.x = width / 2;
        this.y = height * 0.82;
        this.radius = 18;
        this.speed = 7;
        this.hull = 100;
        this.maxHull = 100;
        this.shield = 100;
        this.maxShield = 100;
        this.shieldRechargeDelay = 0;
        
        // Weapons
        this.weaponTier = 1; // 1: Single, 2: Dual, 3: Triple, 4: 5-way Plasma
        this.hasMissiles = false;
        this.missileTimer = 0;
        this.lastShot = 0;
        this.shootInterval = 130;

        // Dash
        this.dashCooldown = 0;
        this.isDashing = false;
        this.dashTimer = 0;
        this.invulnerableTimer = 0;

        // Visual trails
        this.dashGhosts = [];
        this.thrusterParticles = [];
      }

      performDash() {
        if (this.dashCooldown > 0 || this.isDashing) return;
        this.isDashing = true;
        this.dashTimer = 180; // ms
        this.dashCooldown = 1200; // ms cooldown
        this.invulnerableTimer = 350; // Invincible frames!
        sound.playDash();
        screenShake = Math.max(screenShake, 5);
        shockwaves.push(new Shockwave(this.x, this.y, 70, '#38bdf8'));
        floatingTexts.push(new FloatingText('WARP DASH', this.x, this.y - 25, '#38bdf8', 12));
      }

      update(dt, now) {
        // Cooldowns
        if (this.dashCooldown > 0) this.dashCooldown -= dt;
        if (this.invulnerableTimer > 0) this.invulnerableTimer -= dt;

        // Shield natural regen after no hits for 3.5s
        if (this.shieldRechargeDelay > 0) {
          this.shieldRechargeDelay -= dt;
        } else if (this.shield < this.maxShield) {
          this.shield = Math.min(this.maxShield, this.shield + 0.15);
        }

        // Dashing execution
        let moveMultiplier = 1;
        if (this.isDashing) {
          this.dashTimer -= dt;
          moveMultiplier = 2.8;
          warpSpeed = 3.5;
          this.dashGhosts.push({ x: this.x, y: this.y, alpha: 0.8 });
          if (this.dashTimer <= 0) {
            this.isDashing = false;
            warpSpeed = 1;
          }
        }

        // Steering logic (Mouse / Touch interpolation + Keyboard fallback)
        let dirX = 0;
        let dirY = 0;

        if (keys.w || keys.ArrowUp) dirY -= 1;
        if (keys.s || keys.ArrowDown) dirY += 1;
        if (keys.a || keys.ArrowLeft) dirX -= 1;
        if (keys.d || keys.ArrowRight) dirX += 1;

        if (touchState.active) {
          const dx = touchState.x - this.x;
          const dy = (touchState.y - 60) - this.y;
          this.x += dx * 0.18 * moveMultiplier;
          this.y += dy * 0.18 * moveMultiplier;
        } else if (dirX !== 0 || dirY !== 0) {
          const len = Math.hypot(dirX, dirY);
          this.x += (dirX / len) * this.speed * moveMultiplier;
          this.y += (dirY / len) * this.speed * moveMultiplier;
        } else {
          // Smooth follow mouse if mouse button is held or keyboard idle
          const dx = mouse.x - this.x;
          const dy = mouse.y - this.y;
          if (Math.hypot(dx, dy) > 8) {
            this.x += dx * 0.12 * moveMultiplier;
            this.y += dy * 0.12 * moveMultiplier;
          }
        }

        // Clamp inside visible bounds
        this.x = Math.max(this.radius, Math.min(width - this.radius, this.x));
        this.y = Math.max(this.radius + 60, Math.min(height - this.radius - 20, this.y));

        // Dash trigger on Shift
        if (keys.Shift) this.performDash();

        // Firing Loop
        const isFiring = keys.Space || mouse.isDown || touchState.active;
        if (isFiring && now - this.lastShot >= this.shootInterval) {
          this.shoot(now);
        }

        // Secondary Homing Missiles
        if (this.hasMissiles) {
          this.missileTimer += dt;
          if (this.missileTimer >= 550) {
            this.missileTimer = 0;
            this.fireHomingMissiles();
          }
        }

        // Exhaust Particles
        if (Math.random() < 0.8) {
          this.thrusterParticles.push({
            x: this.x + (Math.random() - 0.5) * 8,
            y: this.y + 16,
            vx: (Math.random() - 0.5) * 1.5,
            vy: Math.random() * 4 + 3,
            size: Math.random() * 3 + 1,
            color: this.isDashing ? '#38bdf8' : '#06b6d4',
            alpha: 1
          });
        }

        // Update Ghost Trails
        for (let g of this.dashGhosts) g.alpha -= 0.08;
        this.dashGhosts = this.dashGhosts.filter(g => g.alpha > 0);

        for (let p of this.thrusterParticles) {
          p.x += p.vx;
          p.y += p.vy;
          p.alpha -= 0.05;
        }
        this.thrusterParticles = this.thrusterParticles.filter(p => p.alpha > 0);
      }

      shoot(now) {
        this.lastShot = now;
        sound.playLaser();
        screenShake = Math.max(screenShake, 1.5);

        // Weapon tiers
        if (this.weaponTier === 1) {
          bullets.push(new Bullet(this.x, this.y - 15, 0, -15, '#22d3ee', 15));
        } else if (this.weaponTier === 2) {
          bullets.push(new Bullet(this.x - 10, this.y - 12, 0, -15, '#22d3ee', 15));
          bullets.push(new Bullet(this.x + 10, this.y - 12, 0, -15, '#22d3ee', 15));
        } else if (this.weaponTier === 3) {
          bullets.push(new Bullet(this.x, this.y - 16, 0, -16, '#f43f5e', 22));
          bullets.push(new Bullet(this.x - 12, this.y - 10, -2.5, -15, '#38bdf8', 15));
          bullets.push(new Bullet(this.x + 12, this.y - 10, 2.5, -15, '#38bdf8', 15));
        } else {
          // Tier 4: Overdrive 5-Way Plasma Flurry
          bullets.push(new Bullet(this.x, this.y - 18, 0, -17, '#fbbf24', 28));
          bullets.push(new Bullet(this.x - 8, this.y - 14, -1.8, -16, '#f43f5e', 20));
          bullets.push(new Bullet(this.x + 8, this.y - 14, 1.8, -16, '#f43f5e', 20));
          bullets.push(new Bullet(this.x - 16, this.y - 10, -4.5, -14, '#38bdf8', 15));
          bullets.push(new Bullet(this.x + 16, this.y - 10, 4.5, -14, '#38bdf8', 15));
        }
      }

      fireHomingMissiles() {
        sound.playMissile();
        homingMissiles.push(new HomingMissile(this.x - 16, this.y, -3));
        homingMissiles.push(new HomingMissile(this.x + 16, this.y, 3));
      }

      takeDamage(amount) {
        if (this.invulnerableTimer > 0) return;

        this.shieldRechargeDelay = 3500;
        screenShake = 12;
        glitchEffect = 12;
        sound.playExplosion(1.4);

        if (this.shield > 0) {
          if (this.shield >= amount) {
            this.shield -= amount;
            amount = 0;
          } else {
            amount -= this.shield;
            this.shield = 0;
          }
          shockwaves.push(new Shockwave(this.x, this.y, 60, '#38bdf8'));
        }

        if (amount > 0) {
          this.hull -= amount;
          createExplosion(this.x, this.y, '#f43f5e', 20);
        }

        this.invulnerableTimer = 850; // Invincibility flash
        floatingTexts.push(new FloatingText(`-${Math.round(amount)} HULL`, this.x, this.y - 20, '#ef4444', 12));

        if (this.hull <= 0) {
          this.hull = 0;
          triggerGameOver();
        }
        updateHUD();
      }

      draw(c) {
        // Draw Dash Ghosts
        for (let g of this.dashGhosts) {
          c.save();
          c.globalAlpha = g.alpha * 0.4;
          c.translate(g.x, g.y);
          c.strokeStyle = '#38bdf8';
          c.strokeRect(-12, -12, 24, 24);
          c.restore();
        }

        // Draw Exhausts
        for (let p of this.thrusterParticles) {
          c.save();
          c.globalAlpha = p.alpha;
          c.fillStyle = p.color;
          c.fillRect(p.x, p.y, p.size, p.size);
          c.restore();
        }

        // Flashing invincibility frames
        if (this.invulnerableTimer > 0 && Math.floor(Date.now() / 60) % 2 === 0) {
          return;
        }

        c.save();
        c.translate(this.x, this.y);

        // Dynamic Ship Rendering
        c.shadowColor = this.isDashing ? '#fbbf24' : '#06b6d4';
        c.shadowBlur = 14;
        c.lineWidth = 2.2;
        c.strokeStyle = this.isDashing ? '#fef08a' : '#22d3ee';
        c.fillStyle = '#090d16';

        c.beginPath();
        c.moveTo(0, -22);
        c.lineTo(18, 14);
        c.lineTo(8, 10);
        c.lineTo(0, 16);
        c.lineTo(-8, 10);
        c.lineTo(-18, 14);
        c.closePath();
        c.fill();
        c.stroke();

        // Cockpit crystal
        c.fillStyle = this.isDashing ? '#f59e0b' : '#38bdf8';
        c.beginPath();
        c.ellipse(0, -3, 4, 8, 0, 0, Math.PI * 2);
        c.fill();

        // Energy Shield Ring
        if (this.shield > 0) {
          c.beginPath();
          c.arc(0, 0, 26, 0, Math.PI * 2);
          c.strokeStyle = `rgba(56, 189, 248, ${0.3 + (this.shield / this.maxShield) * 0.5})`;
          c.lineWidth = 2;
          c.shadowColor = '#38bdf8';
          c.shadowBlur = 10;
          c.stroke();
        }

        c.restore();
      }
    }

    // --- Projectiles & Homing Missiles ---
    class Bullet {
      constructor(x, y, vx, vy, color, damage = 15, isEnemy = false) {
        this.x = x;
        this.y = y;
        this.vx = vx;
        this.vy = vy;
        this.color = color;
        this.damage = damage;
        this.isEnemy = isEnemy;
        this.radius = isEnemy ? 4.5 : 3.5;
        this.alive = true;
      }

      update() {
        this.x += this.vx;
        this.y += this.vy;
        if (this.y < -30 || this.y > height + 30 || this.x < -30 || this.x > width + 30) {
          this.alive = false;
        }
      }

      draw(c) {
        c.save();
        c.fillStyle = this.color;
        c.shadowColor = this.color;
        c.shadowBlur = 10;
        c.beginPath();
        c.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
        c.fill();
        c.restore();
      }
    }

    class HomingMissile {
      constructor(x, y, sideBias = 0) {
        this.x = x;
        this.y = y;
        this.vx = sideBias;
        this.vy = -3;
        this.speed = 9;
        this.damage = 45;
        this.alive = true;
        this.life = 120;
      }

      update() {
        this.life--;
        if (this.life <= 0) {
          this.alive = false;
          return;
        }

        // Target nearest alive enemy
        let target = null;
        let minDist = 9999;
        const potentialTargets = currentBoss && currentBoss.alive ? [currentBoss, ...enemies] : enemies;

        for (let e of potentialTargets) {
          if (!e.alive) continue;
          const d = Math.hypot(e.x - this.x, e.y - this.y);
          if (d < minDist) {
            minDist = d;
            target = e;
          }
        }

        if (target) {
          const angle = Math.atan2(target.y - this.y, target.x - this.x);
          this.vx += Math.cos(angle) * 0.9;
          this.vy += Math.sin(angle) * 0.9;
          const currentSpeed = Math.hypot(this.vx, this.vy);
          this.vx = (this.vx / currentSpeed) * this.speed;
          this.vy = (this.vy / currentSpeed) * this.speed;
        }

        this.x += this.vx;
        this.y += this.vy;

        // Exhaust
        particles.push({
          x: this.x,
          y: this.y,
          vx: (Math.random() - 0.5) * 1.5,
          vy: Math.random() * 2,
          color: '#fbbf24',
          alpha: 0.8,
          size: 2
        });
      }

      draw(c) {
        c.save();
        c.translate(this.x, this.y);
        c.rotate(Math.atan2(this.vy, this.vx) + Math.PI / 2);
        c.fillStyle = '#f59e0b';
        c.shadowColor = '#fbbf24';
        c.shadowBlur = 8;
        c.fillRect(-2, -6, 4, 12);
        c.restore();
      }
    }

    // --- Dynamic Enemies ---
    class Enemy {
      constructor(type) {
        this.type = type; // 'scout', 'cruiser', 'stalker', 'meteor'
        this.alive = true;
        this.x = Math.random() * (width - 80) + 40;
