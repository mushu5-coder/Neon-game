        } else if (type === 'stalker') {
          // Cloaking laser sniper
          this.radius = 18;
          this.hp = 45;
          this.maxHp = 45;
          this.speedY = 1.8;
          this.speedX = 0;
          this.score = 250;
          this.color = '#06b6d4';
          this.cloaked = true;
          this.cloakTimer = 0;
        } else {
          // Meteor Shard
          this.radius = Math.random() * 15 + 22;
          this.hp = 50;
          this.maxHp = 50;
          this.speedY = Math.random() * 1.5 + 1.2;
          this.speedX = (Math.random() - 0.5) * 1.2;
          this.score = 150;
          this.color = '#eab308';
          this.rot = 0;
          this.rotSpeed = (Math.random() - 0.5) * 0.05;
        }
      }

      update(dt) {
        this.y += this.speedY;
        this.x += this.speedX;

        // Bounce horizontally
        if (this.x < this.radius || this.x > width - this.radius) {
          this.speedX *= -1;
        }

        // Cruiser Turret Attack
        if (this.type === 'cruiser') {
          this.shootTimer += dt;
          if (this.shootTimer >= 1400) {
            this.shootTimer = 0;
            // Fire 3-way spiral
            const angles = [-0.35, 0, 0.35];
            for (let a of angles) {
              const vx = Math.sin(a) * 5;
              const vy = Math.cos(a) * 5;
              enemyBullets.push(new Bullet(this.x, this.y + 15, vx, vy, '#f43f5e', 12, true));
            }
          }
        }

        // Stalker Cloak Logic
        if (this.type === 'stalker') {
          this.cloakTimer += dt;
          if (this.cloakTimer > 2000) {
            this.cloaked = !this.cloaked;
            this.cloakTimer = 0;
            if (!this.cloaked) {
              // Sudden snipe shot straight down
              enemyBullets.push(new Bullet(this.x, this.y + 15, 0, 8, '#22d3ee', 18, true));
            }
          }
        }

        if (this.type === 'meteor') {
          this.rot += this.rotSpeed;
        }

        if (this.y > height + 60) this.alive = false;
      }

      draw(c) {
        c.save();
        c.translate(this.x, this.y);

        if (this.type === 'scout') {
          c.shadowColor = this.color;
          c.shadowBlur = 10;
          c.strokeStyle = this.color;
          c.lineWidth = 2;
          c.fillStyle = '#111827';
          c.beginPath();
          c.moveTo(0, this.radius);
          c.lineTo(this.radius, -this.radius);
          c.lineTo(0, -this.radius * 0.5);
          c.lineTo(-this.radius, -this.radius);
          c.closePath();
          c.fill();
          c.stroke();
        } else if (this.type === 'cruiser') {
          c.shadowColor = this.color;
          c.shadowBlur = 15;
          c.strokeStyle = this.color;
          c.lineWidth = 2.5;
          c.fillStyle = '#0f172a';
          c.strokeRect(-this.radius, -this.radius, this.radius * 2, this.radius * 2);
          c.fillRect(-this.radius, -this.radius, this.radius * 2, this.radius * 2);
          // Turret core
          c.fillStyle = '#f43f5e';
          c.beginPath();
          c.arc(0, 0, 6, 0, Math.PI * 2);
          c.fill();
        } else if (this.type === 'stalker') {
          c.globalAlpha = this.cloaked ? 0.25 : 1;
          c.shadowColor = this.color;
          c.shadowBlur = 12;
          c.strokeStyle = this.color;
          c.lineWidth = 2;
          c.beginPath();
          c.moveTo(0, -this.radius);
          c.lineTo(this.radius, 0);
          c.lineTo(0, this.radius);
          c.lineTo(-this.radius, 0);
          c.closePath();
          c.stroke();
        } else {
          // Meteor
          c.rotate(this.rot);
          c.shadowColor = this.color;
          c.shadowBlur = 8;
          c.strokeStyle = this.color;
          c.lineWidth = 2;
          c.fillStyle = '#1c1917';
          c.strokeRect(-this.radius, -this.radius, this.radius * 2, this.radius * 2);
          c.fillRect(-this.radius, -this.radius, this.radius * 2, this.radius * 2);
        }

        c.restore();
      }
    }

    // --- Multi-Phase Epic Boss Encounter ---
    class BossDreadnought {
      constructor(waveNum) {
        this.waveNum = waveNum;
        this.alive = true;
        this.x = width / 2;
        this.y = -120;
        this.targetY = 130;
        this.radius = 65;
        this.maxHp = 600 + waveNum * 400;
        this.hp = this.maxHp;
        this.phase = 1; // 1: Turret Barrage, 2: Overdrive Mega Beam
        this.attackTimer = 0;
        this.color = '#f43f5e';
        this.laserCharging = false;
        this.laserChargeTimer = 0;
        this.laserActive = false;
        this.laserActiveTimer = 0;
      }

      update(dt) {
        // Entry slide in
        if (this.y < this.targetY) {
          this.y += 1.5;
        } else {
          // Hover sweep
          this.x = width / 2 + Math.sin(Date.now() * 0.0015) * (width * 0.3);
        }

        // Multi-phase transition at 50% HP
        if (this.hp <= this.maxHp * 0.5 && this.phase === 1) {
          this.phase = 2;
          screenShake = 15;
          sound.playExplosion(2);
          floatingTexts.push(new FloatingText('PHASE 2: MEGA BEAM ONLINE', this.x, this.y + 40, '#f43f5e', 18));
        }

        this.attackTimer += dt;

        // Phase 1: Spiral Bullet Hell
        if (this.phase === 1) {
          if (this.attackTimer >= 900) {
            this.attackTimer = 0;
            const bulletsCount = 8;
            for (let i = 0; i < bulletsCount; i++) {
              const angle = (i / bulletsCount) * Math.PI * 2 + (Date.now() * 0.002);
              const vx = Math.cos(angle) * 4.5;
              const vy = Math.sin(angle) * 4.5;
              enemyBullets.push(new Bullet(this.x, this.y + 20, vx, vy, '#f43f5e', 15, true));
            }
          }
        } 
        // Phase 2: Mega Beam + Homing Swarm
        else {
          if (!this.laserCharging && !this.laserActive && this.attackTimer >= 1800) {
            this.laserCharging = true;
            this.laserChargeTimer = 1000;
            this.attackTimer = 0;
            sound.playBossWarning();
          }

          if (this.laserCharging) {
            this.laserChargeTimer -= dt;
            if (this.laserChargeTimer <= 0) {
              this.laserCharging = false;
              this.laserActive = true;
              this.laserActiveTimer = 1200;
              sound.playEMP();
              screenShake = 12;
            }
          }

          if (this.laserActive) {
            this.laserActiveTimer -= dt;
            screenShake = Math.max(screenShake, 4);

            // Check collision with player beam column
            const beamWidth = 60;
            if (player.x >= this.x - beamWidth / 2 && player.x <= this.x + beamWidth / 2 && player.y > this.y) {
              player.takeDamage(2.5); // Damage tick
            }

            if (this.laserActiveTimer <= 0) {
              this.laserActive = false;
            }
          }
        }

        // Update HUD
        bossHpBar.style.width = `${Math.max(0, (this.hp / this.maxHp) * 100)}%`;
        bossHpVal.textContent = `${Math.round((this.hp / this.maxHp) * 100)}%`;
      }

      draw(c) {
        c.save();
        c.translate(this.x, this.y);

        // Telegraph charge line
        if (this.laserCharging) {
          c.strokeStyle = 'rgba(239, 68, 68, 0.4)';
          c.setLineDash([8, 8]);
          c.lineWidth = 4;
          c.beginPath();
          c.moveTo(0, 0);
          c.lineTo(0, height);
          c.stroke();
          c.setLineDash([]);
        }

        // Full Mega Laser Beam
        if (this.laserActive) {
          c.fillStyle = 'rgba(244, 63, 94, 0.85)';
          c.shadowColor = '#f43f5e';
          c.shadowBlur = 25;
          c.fillRect(-30, 20, 60, height);
          // Inner core
          c.fillStyle = '#ffffff';
          c.fillRect(-12, 20, 24, height);
        }

        // Dreadnought Chassis
        c.shadowColor = this.phase === 2 ? '#f59e0b' : '#f43f5e';
        c.shadowBlur = 20;
        c.strokeStyle = this.phase === 2 ? '#fbbf24' : '#f43f5e';
        c.lineWidth = 3.5;
        c.fillStyle = '#0a0d17';

        c.beginPath();
        c.moveTo(0, 50);
        c.lineTo(65, 0);
        c.lineTo(80, -45);
        c.lineTo(30, -35);
        c.lineTo(0, -25);
        c.lineTo(-30, -35);
        c.lineTo(-80, -45);
        c.lineTo(-65, 0);
        c.closePath();
        c.fill();
        c.stroke();

        // Pulsing Boss Core
        c.fillStyle = this.phase === 2 ? '#fbbf24' : '#ef4444';
        c.beginPath();
        c.arc(0, 5, 14, 0, Math.PI * 2);
        c.fill();

        c.restore();
      }
    }

    // --- Collectible Stardust Cores ---
    class StardustCore {
      constructor(x, y, kind = 'stardust') {
        this.x = x;
        this.y = y;
        this.kind = kind; // 'stardust', 'shield_orb', 'homing_mod'
        this.radius = 11;
        this.alive = true;
        this.vy = 1.6;
        this.color = kind === 'stardust' ? '#22d3ee' : (kind === 'shield_orb' ? '#38bdf8' : '#fbbf24');
      }

      update() {
        // Gravitational magnetic pull toward player
        const dist = Math.hypot(player.x - this.x, player.y - this.y);
        if (dist < 160) {
          const angle = Math.atan2(player.y - this.y, player.x - this.x);
          this.x += Math.cos(angle) * 5.5;
          this.y += Math.sin(angle) * 5.5;
        } else {
          this.y += this.vy;
        }

        if (this.y > height + 30) this.alive = false;
      }

      draw(c) {
        c.save();
        c.translate(this.x, this.y);
        c.shadowColor = this.color;
        c.shadowBlur = 12;
        c.fillStyle = this.color;

        c.beginPath();
        c.moveTo(0, -this.radius);
        c.lineTo(this.radius, 0);
        c.lineTo(0, this.radius);
        c.lineTo(-this.radius, 0);
        c.closePath();
        c.fill();

        c.fillStyle = '#ffffff';
        c.font = 'bold 8px Orbitron';
        c.textAlign = 'center';
        c.textBaseline = 'middle';
        const symbol = this.kind === 'stardust' ? '★' : (this.kind === 'shield_orb' ? 'S' : 'M');
        c.fillText(symbol, 0, 0);
        c.restore();
      }
    }

    // --- Global Entities Collections ---
    const player = new PlayerShip();
    let bullets = [];
    let homingMissiles = [];
    let enemyBullets = [];
    let enemies = [];
    let cores = [];
    let particles = [];
    let shockwaves = [];
    let floatingTexts = [];

    // --- Overdrive EMP Ability Trigger ---
    function triggerOverdriveBomb() {
      if (overdriveMeter < 100) return;
      overdriveMeter = 0;
      sound.playEMP();
      screenShake = 22;
      glitchEffect = 20;

      shockwaves.push(new Shockwave(player.x, player.y, Math.max(width, height), '#fbbf24'));
      floatingTexts.push(new FloatingText('OVERDRIVE DETONATION', width / 2, height / 2, '#fbbf24', 24));

      // Destroy all incoming enemy bullets
      enemyBullets = [];

      // Wipe normal enemies & deal massive boss damage
      for (let e of enemies) {
        e.alive = false;
        createExplosion(e.x, e.y, e.color, 15);
        score += e.score * comboMultiplier;
      }

      if (currentBoss && currentBoss.alive) {
        currentBoss.hp -= 250;
        createExplosion(currentBoss.x, currentBoss.y, '#f43f5e', 35);
        if (currentBoss.hp <= 0) defeatBoss();
      }

      updateHUD();
    }

    function createExplosion(x, y, color, count = 18) {
      for (let i = 0; i < count; i++) {
        const angle = Math.random() * Math.PI * 2;
        const spd = Math.random() * 5 + 1.5;
        particles.push({
          x, y,
          vx: Math.cos(angle) * spd,
          vy: Math.sin(angle) * spd,
          color,
          alpha: 1,
          size: Math.random() * 3 + 1.5
        });
      }
    }

    // --- Wave & Boss Spawner Logic ---
    let spawnTimer = 0;
    let waveKillCount = 0;
    const killsPerWave = 15;

    function handleSpawns(dt) {
      if (bossActive) return; // Halt standard spawn during boss

      spawnTimer += dt;
      const delay = Math.max(380, 1100 - wave * 70);

      if (spawnTimer >= delay) {
        spawnTimer = 0;
        const roll = Math.random();
        let type = 'scout';
        if (roll > 0.75) type = 'cruiser';
        else if (roll > 0.5) type = 'stalker';
        else if (roll > 0.3) type = 'meteor';

        enemies.push(new Enemy(type));
      }

      // Check if boss should be summoned
      if (waveKillCount >= killsPerWave) {
        summonBoss();
      }
    }

    function summonBoss() {
      bossActive = true;
      bossHud.classList.remove('hidden');
      bossHud.classList.add('flex');
      bossWarning.classList.remove('hidden');
      bossWarning.classList.add('flex');
      sound.playBossWarning();

      setTimeout(() => {
        bossWarning.classList.add('hidden');
        bossWarning.classList.remove('flex');
        currentBoss = new BossDreadnought(wave);
      }, 2200);
    }

    function defeatBoss() {
      currentBoss.alive = false;
      bossActive = false;
      currentBoss = null;
      bossHud.classList.add('hidden');
      bossHud.classList.remove('flex');

      sound.playExplosion(3);
      screenShake = 25;
      score += 5000 * comboMultiplier;

      floatingTexts.push(new FloatingText('BOSS DESTROYED! +5000', width / 2, height / 2, '#34d399', 22));

      // Advance wave
      wave++;
      waveKillCount = 0;
      updateHUD();
    }

    // --- Collision Detection Matrix ---
    function checkCollisions() {
      // 1. Player Bullets vs Enemies
      for (let b of bullets) {
        if (!b.alive) continue;
        for (let e of enemies) {
          if (!e.alive) continue;
          if (Math.hypot(b.x - e.x, b.y - e.y) < b.radius + e.radius) {
            b.alive = false;
            e.hp -= b.damage;
            createExplosion(b.x, b.y, b.color, 4);

            if (e.hp <= 0) {
              onEnemyDestroyed(e);
            }
            break;
          }
        }

        // Bullets vs Boss
        if (b.alive && currentBoss && currentBoss.alive) {
          if (Math.hypot(b.x - currentBoss.x, b.y - currentBoss.y) < b.radius + currentBoss.radius) {
            b.alive = false;
            currentBoss.hp -= b.damage;
            createExplosion(b.x, b.y, '#f43f5e', 4);
            if (currentBoss.hp <= 0) defeatBoss();
          }
        }
      }

      // 2. Homing Missiles Collisions
      for (let m of homingMissiles) {
        if (!m.alive) continue;
        for (let e of enemies) {
          if (!e.alive) continue;
          if (Math.hypot(m.x - e.x, m.y - e.y) < 8 + e.radius) {
            m.alive = false;
            e.hp -= m.damage;
            sound.playExplosion(1.2);
            shockwaves.push(new Shockwave(m.x, m.y, 45, '#fbbf24'));
            createExplosion(m.x, m.y, '#fbbf24', 12);
            if (e.hp <= 0) onEnemyDestroyed(e);
            break;
          }
        }
        if (m.alive && currentBoss && currentBoss.alive) {
          if (Math.hypot(m.x - currentBoss.x, m.y - currentBoss.y) < 8 + currentBoss.radius) {
            m.alive = false;
            currentBoss.hp -= m.damage;
            sound.playExplosion(1.5);
            shockwaves.push(new Shockwave(m.x, m.y, 60, '#fbbf24'));
            if (currentBoss.hp <= 0) defeatBoss();
          }
        }
      }

      // 3. Enemy Projectiles vs Player
      for (let eb of enemyBullets) {
        if (!eb.alive) continue;
        if (Math.hypot(eb.x - player.x, eb.y - player.y) < eb.radius + player.radius) {
          eb.alive = false;
          player.takeDamage(eb.damage);
        }
      }

      // 4. Player vs Enemies (Ramming)
      for (let e of enemies) {
        if (!e.alive) continue;
        if (Math.hypot(player.x - e.x, player.y - e.y) < player.radius + e.radius) {
          e.alive = false;
          createExplosion(e.x, e.y, e.color, 16);
          player.takeDamage(25);
          break;
        }
      }

      // 5. Player Collects Cores
      for (let c of cores) {
        if (!c.alive) continue;
        if (Math.hypot(player.x - c.x, player.y - c.y) < player.radius + c.radius) {
          c.alive = false;
          sound.playPowerup();
          shockwaves.push(new Shockwave(c.x, c.y, 35, c.color));

          if (c.kind === 'stardust') {
            player.weaponTier = Math.min(4, player.weaponTier + 1);
            overdriveMeter = Math.min(100, overdriveMeter + 20);
            floatingTexts.push(new FloatingText('WEAPON UPGRADE!', player.x, player.y - 25, '#22d3ee', 13));
          } else if (c.kind === 'shield_orb') {
            player.shield = player.maxShield;
            floatingTexts.push(new FloatingText('SHIELD RECHARGED', player.x, player.y - 25, '#38bdf8', 13));
          } else {
            player.hasMissiles = true;
            floatingTexts.push(new FloatingText('HOMING MISSILES ARMED', player.x, player.y - 25, '#fbbf24', 13));
          }
          updateHUD();
        }
      }
    }

    function onEnemyDestroyed(e) {
      e.alive = false;
      kills++;
      waveKillCount++;
      comboStreak++;
      comboTimer = 2800; // Combo reset window

      // Multiplier ramps up to 10x
      comboMultiplier = Math.min(10, Math.floor(comboStreak / 4) + 1);
      if (comboMultiplier > maxSessionCombo) maxSessionCombo = comboMultiplier;

      const gainedScore = e.score * comboMultiplier;
      score += gainedScore;

      sound.playExplosion(1);
      createExplosion(e.x, e.y, e.color, 16);
      shockwaves.push(new Shockwave(e.x, e.y, 40, e.color));

      // Overdrive boost
      overdriveMeter = Math.min(100, overdriveMeter + 6);

      // Random Core Drops (18% chance)
      if (Math.random() < 0.2) {
        const roll = Math.random();
        let kind = 'stardust';
        if (roll > 0.65) kind = 'shield_orb';
        else if (roll > 0.4) kind = 'homing_mod';
        cores.push(new StardustCore(e.x, e.y, kind));
      }

      floatingTexts.push(new FloatingText(`+${gainedScore}`, e.x, e.y, '#38bdf8', 11));
      updateHUD();
    }

    // --- HUD Syncing ---
    function updateHUD() {
      scoreDisplay.textContent = score.toString().padStart(6, '0');
      waveVal.textContent = wave;
      hpVal.textContent = `${Math.round(player.hull)}%`;
      hpBar.style.width = `${Math.max(0, player.hull)}%`;
      shieldVal.textContent = `${Math.round(player.shield)}%`;
      shieldBar.style.width = `${Math.max(0, player.shield)}%`;

      overdriveVal.textContent = `${Math.round(overdriveMeter)}%`;
      overdriveBar.style.width = `${overdriveMeter}%`;

      // Dash state badge
      if (player.dashCooldown <= 0) {
        dashBadge.className = 'px-2 py-0.5 rounded text-[9px] font-bold border border-cyan-500/50 text-cyan-300 bg-cyan-950/40 animate-pulse';
        dashBadge.textContent = 'DASH: RDY [SHIFT]';
      } else {
        dashBadge.className = 'px-2 py-0.5 rounded text-[9px] font-bold border border-slate-700 text-slate-500 bg-slate-900';
        dashBadge.textContent = 'DASH: CHARGING';
      }

      // Weapon tier pips
      for (let i = 0; i < weaponPips.length; i++) {
        if (i < player.weaponTier) {
          weaponPips[i].className = 'w-2.5 h-2.5 rounded bg-fuchsia-400 shadow-[0_0_8px_#f43f5e]';
        } else {
          weaponPips[i].className = 'w-2.5 h-2.5 rounded bg-slate-800 border border-slate-700';
        }
      }

      // Combo Pill
      if (comboStreak > 1) {
        comboPill.classList.remove('hidden');
        comboVal.textContent = `${comboMultiplier} (${comboStreak} STREAK)`;
      } else {
        comboPill.classList.add('hidden');
      }
    }

    // --- State Handlers ---
    function triggerGameOver() {
      gameState = 'GAMEOVER';
      sound.playExplosion(2.8);
      screenShake = 30;

      if (score > highScore) {
        highScore = score;
        localStorage.setItem('neon_void_od_hiscore', highScore);
      }
      if (maxSessionCombo > recordMaxCombo) {
        recordMaxCombo = maxSessionCombo;
        localStorage.setItem('neon_void_od_maxcombo', recordMaxCombo);
      }

      finalScore.textContent = score.toLocaleString();
      finalWave.textContent = wave;
      finalKills.textContent = kills;
      finalCombo.textContent = `${maxSessionCombo}x`;
      bestScoreEl.textContent = highScore.toLocaleString();

      setTimeout(() => {
        gameOverScreen.classList.remove('hidden');
        gameOverScreen.classList.add('flex');
      }, 600);
    }

    function togglePause() {
      if (gameState === 'PLAYING') {
        gameState = 'PAUSED';
        pauseScreen.classList.remove('hidden');
        pauseScreen.classList.add('flex');
      } else if (gameState === 'PAUSED') {
        gameState = 'PLAYING';
        pauseScreen.classList.add('hidden');
        pauseScreen.classList.remove('flex');
        lastTime = performance.now();
      }
    }

    function restartCombat() {
      bullets = [];
      homingMissiles = [];
      enemyBullets = [];
      enemies = [];
      cores = [];
      particles = [];
      shockwaves = [];
      floatingTexts = [];

      score = 0;
      kills = 0;
      wave = 1;
      waveKillCount = 0;
      comboStreak = 0;
      comboMultiplier = 1;
      comboTimer = 0;
      overdriveMeter = 0;
      bossActive = false;
      currentBoss = null;

      player.reset();
      updateHUD();

      startScreen.classList.add('hidden');
      pauseScreen.classList.add('hidden');
      gameOverScreen.classList.add('hidden');
      bossHud.classList.add('hidden');

      gameState = 'PLAYING';
      lastTime = performance.now();
      sound.startMusic();
    }

    // --- Main Rendering & Animation Loop ---
    let lastTime = performance.now();

    function engineLoop(now) {
      const dt = Math.min(now - lastTime, 50);
      lastTime = now;

      ctx.save();

      // Screen Shake & Glitch Transformation
      if (screenShake > 0) {
        const sx = (Math.random() - 0.5) * screenShake;
        const sy = (Math.random() - 0.5) * screenShake;
        ctx.translate(sx, sy);
        screenShake = Math.max(0, screenShake - 0.7);
      }

      // Clear Canvas Frame
      ctx.fillStyle = '#02040a';
      ctx.fillRect(0, 0, width, height);

      // Starfield Background
      for (let s of starfield) {
        s.update();
        s.draw(ctx);
      }

      if (gameState === 'PLAYING') {
        // Combo decay
        if (comboTimer > 0) {
          comboTimer -= dt;
          if (comboTimer <= 0) {
            comboStreak = 0;
            comboMultiplier = 1;
            updateHUD();
          }
        }

        handleSpawns(dt);

        // Player Vessel
        player.update(dt, now);
        player.draw(ctx);

        // Player Projectiles
        for (let b of bullets) {
          b.update();
          b.draw(ctx);
        }
        bullets = bullets.filter(b => b.alive);

        for (let m of homingMissiles) {
          m.update();
          m.draw(ctx);
        }
        homingMissiles = homingMissiles.filter(m => m.alive);

        // Enemy Bullets
        for (let eb of enemyBullets) {
          eb.update();
          eb.draw(ctx);
        }
        enemyBullets = enemyBullets.filter(eb => eb.alive);

        // Enemies
        for (let e of enemies) {
          e.update(dt);
          e.draw(ctx);
        }
        enemies = enemies.filter(e => e.alive);

        // Boss
        if (currentBoss && currentBoss.alive) {
          currentBoss.update(dt);
          currentBoss.draw(ctx);
        }

        // Collectible Cores
        for (let c of cores) {
          c.update();
          c.draw(ctx);
        }
        cores = cores.filter(c => c.alive);

        // Check Collisions
        checkCollisions();
      }

      // Universal Effects (Particles, Shockwaves, Text)
      for (let sw of shockwaves) {
        sw.update();
        sw.draw(ctx);
      }
      shockwaves = shockwaves.filter(sw => sw.alive);

      for (let p of particles) {
        p.x += p.vx;
        p.y += p.vy;
        p.alpha -= 0.025;
        ctx.save();
        ctx.globalAlpha = Math.max(0, p.alpha);
        ctx.fillStyle = p.color;
        ctx.fillRect(p.x, p.y, p.size, p.size);
        ctx.restore();
      }
      particles = particles.filter(p => p.alpha > 0);

      for (let ft of floatingTexts) {
        ft.update();
        ft.draw(ctx);
      }
      floatingTexts = floatingTexts.filter(ft => ft.alpha > 0);

      // Chromatic Glitch Flash Overlay
      if (glitchEffect > 0) {
        glitchEffect--;
        ctx.fillStyle = 'rgba(239, 68, 68, 0.12)';
        ctx.fillRect(0, 0, width, height);
      }

      ctx.restore();
      requestAnimationFrame(engineLoop);
    }

    // --- Buttons Event Listeners ---
    btnStart.addEventListener('click', () => {
      sound.init();
      restartCombat();
    });

    btnResume.addEventListener('click', () => togglePause());
    btnQuit.addEventListener('click', () => {
      gameState = 'START';
      pauseScreen.classList.add('hidden');
      pauseScreen.classList.remove('flex');
      startScreen.classList.remove('hidden');
      startScreen.classList.add('flex');
      menuHiScore.textContent = highScore.toLocaleString();
      menuMaxCombo.textContent = `${recordMaxCombo}x`;
    });

    btnRestart.addEventListener('click', () => {
      sound.init();
      restartCombat();
    });

    btnPause.addEventListener('click', () => togglePause());

    window.onload = () => {
      requestAnimationFrame(engineLoop);
    };
  </script>
</body>
</html>
